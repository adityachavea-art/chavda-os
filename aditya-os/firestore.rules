rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function workspaceId() {
      return userData().workspaceOwnerId != null
        ? userData().workspaceOwnerId
        : request.auth.uid;
    }

    function canAccessWorkspace(wsId) {
      return isSignedIn() && (request.auth.uid == wsId || workspaceId() == wsId);
    }

    function userRole() {
      return userData().role;
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || canAccessWorkspace(userId));
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /clients/{id} {
        allow read, write: if canAccessWorkspace(userId);
      }
      match /compliance/{id} {
        allow read, write: if canAccessWorkspace(userId);
      }
      match /invoices/{id} {
        allow read, write: if canAccessWorkspace(userId);
      }
      match /tasks/{id} {
        allow read, write: if canAccessWorkspace(userId);
      }
      match /notes/{id} {
        allow read, write: if canAccessWorkspace(userId);
      }
      match /payments/{id} {
        allow read, write: if canAccessWorkspace(userId);
      }
      match /documents/{id} {
        allow read, write: if canAccessWorkspace(userId);
      }
      match /activity/{id} {
        allow read, create: if canAccessWorkspace(userId);
        allow update, delete: if canAccessWorkspace(userId) && isAdmin();
      }
      match /notifications/{id} {
        allow read, write: if canAccessWorkspace(userId);
      }
      match /backups/{id} {
        allow read, write: if canAccessWorkspace(userId) && isAdmin();
      }
      match /team/{id} {
        allow read: if canAccessWorkspace(userId);
        allow write: if canAccessWorkspace(userId) && isAdmin();
      }
    }
  }
}
