rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /workspaces/{workspaceId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && (request.auth.uid == workspaceId
            || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.workspaceOwnerId == workspaceId);
    }
  }
}
